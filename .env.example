# Big Data Analytics - Project Environment Configuration
# Copy this file to .env and configure machine-specific paths

# Java JDK 17+ configuration
JAVA_HOME=C:\Program Files\Java\jdk-23

# Python interpreter in local virtual environment
PYSPARK_PYTHON=d:\BDA\.venv\Scripts\python.exe
PYSPARK_DRIVER_PYTHON=d:\BDA\.venv\Scripts\python.exe

# Spark Local Network Binding
SPARK_LOCAL_IP=127.0.0.1

# Project Directory Overrides
PROJECT_DATA_DIR=d:\BDA\data
PROJECT_CONFIG_PATH=d:\BDA\config\settings.yaml
